# Copy values into your existing .env; never commit credentials.
DB_CONNECT_STRING=mongodb://127.0.0.1:27017/suraksha
REDIS_URL=redis://127.0.0.1:6379
JWT_KEY=replace-with-a-long-random-secret
PORT=3000
FRONTEND_URL=http://localhost:5173
# When PUBLIC_BASE_URL is set (or NODE_ENV=production), auth cookies use
# SameSite=None; Secure so a separately hosted HTTPS frontend can authenticate.
GEMINI_API_KEY=
# Optional runtime failover. Prefer this comma-separated pool when using multiple keys.
# GEMINI_API_KEYS=first_key,second_key
# GEMINI_API_KEY_2=second_key
GEMINI_KEY_COOLDOWN_SECONDS=60
# Set a Gemini model available to your account with function-calling support.
AGENT_MODEL=gemini-3.6-flash
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_MODEL_TIMEOUT_SECONDS=90
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS backend origin, without a trailing path; needed for secure contact response links and Twilio callbacks.
PUBLIC_BASE_URL=
# review: propose only; approved proposals may send. live: automatic bounded sends.
# off: disable Gemini follow-ups; SOS sessions and deterministic coordination remain enabled.
AGENT_MODE=review
AGENT_CHECK_SECONDS=60
AGENT_SESSION_MINUTES=30
AGENT_MAX_RUNS=12
AGENT_MAX_FOLLOWUPS=3

# Nearby responder radii must increase, and cannot exceed 10 km.
RESPONDER_RADIUS_INITIAL_METERS=1000
RESPONDER_RADIUS_SECONDARY_METERS=2000
RESPONDER_RADIUS_MAX_METERS=3000
# Request lifetime and minimum wait between expansion stages.
RESPONDER_ACCEPT_TIMEOUT_SECONDS=30
# Maximum age of eligible community/responder/victim locations.
RESPONDER_LOCATION_STALE_SECONDS=120
# Proximity zones. Arrival also requires combined GPS accuracy <= arrival threshold.
RESPONDER_GEOFENCE_APPROACHING_METERS=500
RESPONDER_GEOFENCE_NEAR_METERS=100
RESPONDER_GEOFENCE_ARRIVED_METERS=20
# Both movement and interval are required for movement-driven searches.
EMERGENCY_GEOFENCE_RECALC_DISTANCE_METERS=250
EMERGENCY_GEOFENCE_RECALC_SECONDS=30
# Hard per-incident request cap; requests are never reissued to the same person.
RESPONDER_MAX_REQUESTS_PER_SESSION=200
# Optional journey monitoring; requires repeated outside readings AND elapsed time.
JOURNEY_DESTINATION_RADIUS_METERS=150
JOURNEY_DEVIATION_TOLERANCE_METERS=200
JOURNEY_DEVIATION_CONFIRM_SECONDS=60
GEOFENCE_REQUIRED_OUTSIDE_SAMPLES=3
JOURNEY_ARRIVAL_GRACE_MINUTES=5
JOURNEY_CHECKIN_TIMEOUT_SECONDS=300
# Persisted location update rate limit, GPS quality and jump thresholds.
GEO_LOCATION_MIN_INTERVAL_SECONDS=5
GEO_MAX_ACCURACY_METERS=250
# Journeys may start and display movement from a coarse laptop/network fix.
# Arrival and deviation checks still account for the reported accuracy.
JOURNEY_MAX_ACCURACY_METERS=2000
GEO_MAX_SPEED_METERS_PER_SECOND=70
# Public heatmap grid in degrees (0.01 is about 1.1 km of latitude).
PUBLIC_HEATMAP_GRID_DEGREES=0.01
# Search and driving directions adapters (public demo providers; replace for production).
JOURNEY_PLACE_SEARCH_URL=https://photon.komoot.io/api
JOURNEY_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
# Maximum persisted vertices after bend-preserving route simplification.
JOURNEY_MAX_ROUTE_POINTS=2000
ENABLE_DEMO_MODE=false
# Allows the signed-in user to explicitly send clearly labelled demo SMS
# messages to their own active SMS contacts from the simulator.
ENABLE_DEMO_SMS=false
DEMO_RESPONDER_TIMEOUT_SECONDS=5
DEMO_DEVIATION_CONFIRM_SECONDS=3
